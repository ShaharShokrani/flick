# Required to sign in and sync a deck across devices.
# Local `npm run dev` can omit DATABASE_URL and will use data/pglite.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:43147

# Shared Postgres (Neon). Required on Vercel so the phone and computer
# see the same words. Use the same URL in .env.local.
DATABASE_URL=

# Optional Google sign-in.
# Authorized redirect: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
