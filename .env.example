# Cloud Postgres (Prisma, Neon, or Vercel Postgres). Required.
# Must be a direct connection string, not prisma+postgres://accelerate…
# postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=

# Auth
BETTER_AUTH_SECRET=
